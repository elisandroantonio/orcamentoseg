# MODELO — copie este arquivo para ".env.teste" (sem o ".example") e
# preencha a linha do DATABASE_URL com a conexão do cluster de TESTE.
# ".env.teste" nunca é versionado (já está no .gitignore).

# Cole aqui a "Connection String" do cluster de TESTE no TiDB Cloud
# (Console TiDB Cloud → seu cluster de teste → botão "Connect").
DATABASE_URL='mysql://usuario:senha@host:4000/nome_do_banco?ssl={"rejectUnauthorized":true}'

# Pode repetir os mesmos valores do .env real para o resto:
JWT_SECRET=3bcaea39c426ea14c42bef083c5425f975acebdf01b6ba98c46dc1b75c9e3294
NODE_ENV=development
PORT=3001
VITE_APP_ID=orcamento-obras-teste
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Deixe em branco aqui — no banco de teste (vazio, sem os seus orçamentos
# reais) o login local mostra a lista de contas normalmente, e você escolhe
# a que quiser usar para testar.
OWNER_OPEN_ID=
